# Input: any valid list of numbers
# Output: the sorted input list

numbers = input...;

loop:
	status = 0; # swap indicator
	newNumbers = [];
	while ρ numbers > 1: # While there are at least two numbers left
		if numbers[0] ≤ numbers[1]: # The two next numbers are in order
			newNumbers[] = numbers[0]; # Append the first number of the pair, the second will still be compared
			numbers = numbers[1:]; # Remove the first number that was appended to newNumbers
		else: # The two next numbers are not in order
			newNumbers[] = numbers[1]; # Append the second number of the pair
			status = numbers[0]; # Repurpose temporarily this variable to avoid a new tape for a new variable
			numbers[:2] = []; # Delete the pair
			numbers[:0] = status; # Return the second number from the pair
			status = 1; # Remember that something was swapped
		endif;
	endwhile;
	newNumbers[] = numbers...;

	if status==0:
		break;
	endif;

	numbers = newNumbers...;
endloop;

output = newNumbers...;
