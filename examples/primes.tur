# Input: one number n
# Output: all prime numbers less than n

bound = input;

states = [];

for x = 2; x < bound; x++:
	states[] = 1;
endfor;

primes = [];

for x = 2; x < bound; x++:
	if states[0]==1:
		primes[] = x;

		states = states[1:];

		if x ⋅ x < bound:
			newStates = [];

			y = x;
			y++;
			for ; y < bound; y++:
				if states[0]==0 ∨ (y mod x)==0:
					newStates[] = 0;
				else:
					newStates[] = 1;
				endif;
				states = states[1:];
			endfor;

			states = newStates…;
		endif;
	else:
		states = states[1:];
	endif;
endfor;

output = primes…;
